# 카카오모빌리티 길찾기 REST API 키
# ----------------------------------------------------------------------------
# 이 파일을 .env 로 복사한 뒤 키를 채우세요.
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# .env 는 .gitignore 에 있어 커밋되지 않으며, 개발 서버가 서버 쪽에서만 읽습니다.
# 즉 이 방식으로 넣은 키는 브라우저에 노출되지 않습니다.
# 값을 바꾸면 서버 재시작 없이 바로 반영됩니다.
#
# 발급: 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_KEY=

# 개발 서버 포트 (기본 3000, 사용 중이면 자동으로 다음 포트를 씁니다)
# 카카오 디벨로퍼스 [플랫폼 → Web] 에 등록한 포트와 일치해야 합니다.
# PORT=3000
